# ==============================
# KAKAO 클라이언트 ID, 시크릿 키, 리다이렉트 URL 적용
# ==============================
KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=NEED_TO_SET
KAKAO_REDIRECT_URI=NEED_TO_SET

# ==============================
# JWT 시크릿 키, JWT 서명용
# ==============================
JWT_SECRET_KEY=NEED_TO_SET

# ==============================
# Database (mySQL) DB 만들어져 있어야함
# ==============================
SQLALCHEMY_DATABASE_URI=mysql+pymysql://사용자명:비밀번호@localhost:3306/cheonanon

# ==============================
# TourAPI 접근키 (공공데이터포털에서 발급, 일일 호출 한도가 있을 수 있음)
# ==============================
TOURAPI_KEY=NEED_TO_SET

# ==============================
# 개발 서버 디버그 모드 (python wsgi.py 실행 시 1이면 디버그/자동 재시작)
# 로컬 개발에서만 1로 바꾼다. 외부에서 접근 가능한 환경에서 켜면 위험하다.
# ==============================
FLASK_DEBUG=0
