# ==============================
# KAKAO 클라이언트 ID(카카오 자동차 길찾기도 동일하게 사용), 시크릿 키, 리다이렉트 URL 적용
# ==============================
KAKAO_CLIENT_ID=YOUR_KAKAO_REST_API_KEY
KAKAO_CLIENT_SECRET=NEED_TO_SET
KAKAO_REDIRECT_URI=NEED_TO_SET
KAKAO_ADMIN_KEY=NEED_TO_SET

# ==============================
# JWT 시크릿 키, JWT 서명용
# ==============================
JWT_SECRET_KEY=NEED_TO_SET

# ==============================
# Database (mySQL) DB 만들어져 있어야함 (로컬)
# ==============================
SQLALCHEMY_DATABASE_URI=mysql+pymysql://사용자명:비밀번호@localhost:3306/meoji

# ==============================
# Docker Compose의 MySQL 컨테이너 설정 (docker compose로 실행할 때만 사용)
# 컨테이너 안의 SQLALCHEMY_DATABASE_URI는 compose가 이 값으로 만들어 덮어쓴다.
# 비밀번호는 URI에 들어가므로 영문자와 숫자만 쓴다.
# ==============================
MYSQL_DATABASE=meoji
MYSQL_USER=meoji
MYSQL_PASSWORD=NEED_TO_SET

# ==============================
# 배포 (Caddy가 HTTPS를 처리할 api 도메인, docker compose로 실행할 때만 사용)
# 운영 서버: 보유한 도메인에 만든 api 주소(예: api.example.com). 비우면 localhost
# ==============================
API_DOMAIN=localhost

# ==============================
# TourAPI 접근키 (공공데이터포털에서 발급, 일일 호출 한도가 있을 수 있음)
# ==============================
TOURAPI_KEY=NEED_TO_SET

# ==============================
# ODsayAPI 키 (ODasyLAB에서 발급, 현재는 로컬IP로 사용중, 일일 호출 한도 30건이 있음)
# ==============================
ODSAY_API_KEY=NEED_TO_SET

# ==============================
# 개발 서버 디버그 모드 (python wsgi.py 실행 시 1이면 디버그/자동 재시작)
# 로컬 개발에서만 1로 바꾼다. 외부에서 접근 가능한 환경에서 켜면 위험하다.
# ==============================
FLASK_DEBUG=1

# ==============================
# 리뷰 이미지 저장소 (S3 호환: 자체 서버 Garage, AWS S3, Cloudflare R2 등)
# 저장소를 옮길 때는 이 값들만 바꾼다. AWS S3는 S3_ENDPOINT를 비운다.
# Cloudflare R2 예: S3_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com, S3_REGION=auto
# S3_PUBLIC_URL을 비우면 이미지 URL을 1시간짜리 presigned URL로 만든다.
# ==============================
S3_ENDPOINT=NEED_TO_SET
S3_REGION=auto
S3_BUCKET=meoji-review-images
S3_ACCESS_KEY=NEED_TO_SET
S3_SECRET_KEY=NEED_TO_SET
S3_PUBLIC_URL=
